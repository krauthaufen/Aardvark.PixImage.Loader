<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Aardvark.Data</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Loads and saves Aardvark PixImages, mip maps, cube maps and volumes with the pure managed Aardvark.PixImage.IO.Codecs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/krauthaufen/Aardvark.PixImage.IO</RepositoryUrl>
    <PackageProjectUrl>https://github.com/krauthaufen/Aardvark.PixImage.IO</PackageProjectUrl>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aardvark.Base.Tensors" Version="5.3.26" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aardvark.PixImage.IO.Codecs\Aardvark.PixImage.IO.Codecs.csproj" />
  </ItemGroup>
</Project>
